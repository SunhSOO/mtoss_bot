# 이 파일을 .env로 복사해서 쓰세요. .env는 Git이 무시합니다.
# 실제 브로커 자격증명이나 텔레그램 토큰을 이 예시 파일에 넣지 마세요.

# ── 필수 ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mtoss:mtoss@localhost:5432/mtoss
INTERNAL_API_KEY=replace-with-a-long-random-value

# ── 선택 ────────────────────────────────────────────────────────────────
# 실행 경로는 PostgreSQL 아웃박스만 씁니다. Redis가 없어도 주문은 나갑니다.
# 설치하지 않았다면 이 줄을 지우거나 주석 처리하세요 — 값이 있으면 헬스체크가 접속을 시도합니다.
# REDIS_URL=redis://localhost:6379/0

CONSOLE_STUB_ENABLED=false
READINESS_TIMEOUT_SECONDS=2.0

# ── MT5 ─────────────────────────────────────────────────────────────────
# 터미널이 이미 로그인된 채 떠 있으면 login/password/server 없이 붙습니다.
MT5_ENABLED=false
# MT5_TERMINAL_PATH=C:\Program Files\Infinox MetaTrader 5 Terminal\terminal64.exe
# MT5_LOGIN=87902957
# MT5_SERVER=InfinoxLimited-MT5Live
# MT5_PASSWORD=          # 가능하면 Windows 자격증명 관리자를 쓰고 여기 두지 마세요

# 섀도 모드 스위치. false면 order_send만 막고 나머지는 전부 실제로 돕니다.
# 실계좌 붙이기 전 마지막 안전장치라 기본값이 꺼짐입니다.
MT5_SUBMIT_ENABLED=false

# ── 텔레그램 ────────────────────────────────────────────────────────────
# 이 chat_id에서 온 콜백만 받아들입니다. 비워 두면 텔레그램 기능 전체가 꺼집니다.
# 없으면 봇 이름을 알아낸 누구나 실계좌 진입 버튼을 누를 수 있습니다.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
